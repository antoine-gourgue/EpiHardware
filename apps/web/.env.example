# Next.js loads env from this app directory. Copy to apps/web/.env

# Demo mode: "true" runs the whole app with mocked data and no database.
# Set to "false" (or remove) and provide DATABASE_URL below to use PostgreSQL.
NEXT_PUBLIC_DEMO_MODE=true

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST=true

# PostgreSQL (only needed when NEXT_PUBLIC_DEMO_MODE is not "true")
# DATABASE_URL="postgresql://epihardware:epihardware@localhost:5432/epihardware?schema=public"
