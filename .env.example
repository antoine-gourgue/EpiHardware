# Copy to .env at the repo root. Turborepo loads it for every workspace.

# PostgreSQL (matches docker-compose.yml). Leave DATABASE_URL empty to run in demo mode.
DATABASE_URL="postgresql://epihardware:epihardware@localhost:5432/epihardware?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST=true

# Demo mode: "true" serves mocked data and disables writes, so the app runs with no database.
# Leave unset / "false" to use PostgreSQL.
NEXT_PUBLIC_DEMO_MODE=false
